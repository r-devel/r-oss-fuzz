Grow the approximate matcher's delete-handling deque while it is
processed, not only while it is first filled.

tre_tnfa_run_approx() queues states for its delete pass in a 256-entry
buffer that grows while the deque is first filled, but the loop that
processes the deque still treats that buffer as a ring, guarded only by
an assert().  One state that reaches many others by deletion overflows
it:

    p <- paste0("x(", paste(rep("a", 300), collapse = "|"), ")b")
    agrep(p, "zzz", max.distance = 2, fixed = FALSE)

fails with "assertion 'deque_end != deque_start' failed in executing
regexp", as it does in R 4.6.1, whose copy has the same loop.  With
instrumentation/0009 that aborts; one of the laurikari/tre#58 inputs
reaches it through the agrep target's agrep(fixed = FALSE) call.  Make
the deque a FIFO that never wraps: when an append reaches the end of
the buffer, the pending entries move to the front if at least half of it
has been consumed, and the buffer grows otherwise.

Upstream status: laurikari/tre PR #145 (r-devel/tre branch
fix-approx-ringbuffer, in its r-integration branch); r-devel/r-svn PR
#537 re-vendors that branch (no Bugzilla report yet).
Delete this patch once the fix lands in R trunk (ossfuzz.sh will report
it as already-applied in the meantime, which is harmless).

diff --git a/src/extra/tre/tre-match-approx.c b/src/extra/tre/tre-match-approx.c
index bb0af40438..8ec45b0cda 100644
--- a/src/extra/tre/tre-match-approx.c
+++ b/src/extra/tre/tre-match-approx.c
@@ -194,6 +194,60 @@ tre_set_params(tre_tnfa_approx_reach_t *reach,
     reach->params.max_err = value;
 }
 
+/* Makes room for one more entry at `*deque_end' in the delete-handling
+   deque, whose pending entries run from `*deque_start' to `*deque_end'
+   in `*ringbuffer'.  The deque never wraps around: the entries before
+   `*deque_start' have been consumed, so if they are at least as many as
+   the pending ones, the pending ones are moved to the front; otherwise
+   the buffer grows, moving from `static_ringbuffer' to the heap the first
+   time.  Returns REG_ESPACE, having freed any heap buffer, if out of
+   memory. */
+static reg_errcode_t
+tre_deque_reserve(tre_tnfa_approx_reach_t ***ringbuffer,
+		  tre_tnfa_approx_reach_t **static_ringbuffer, int *rb_size,
+		  tre_tnfa_approx_reach_t ***deque_start,
+		  tre_tnfa_approx_reach_t ***deque_end)
+{
+  tre_tnfa_approx_reach_t **larger_buf;
+  size_t consumed = *deque_start - *ringbuffer;
+  size_t pending = *deque_end - *deque_start;
+
+  if (*deque_end < *ringbuffer + *rb_size)
+    return REG_OK;
+
+  if (consumed >= pending)
+    {
+      memmove(*ringbuffer, *deque_start, sizeof(**ringbuffer) * pending);
+      *deque_start = *ringbuffer;
+      *deque_end = *ringbuffer + pending;
+      return REG_OK;
+    }
+
+  if (*ringbuffer == static_ringbuffer)
+    {
+      larger_buf = xmalloc(sizeof(*larger_buf) * (*rb_size + 512));
+      if (larger_buf != NULL)
+	memcpy(larger_buf, static_ringbuffer, sizeof(*larger_buf) * *rb_size);
+    }
+  else
+    {
+      larger_buf = xrealloc(*ringbuffer,
+			    sizeof(*larger_buf) * (*rb_size + 512));
+    }
+  if (larger_buf == NULL)
+    {
+      if (*ringbuffer != static_ringbuffer)
+	xfree(*ringbuffer);
+      return REG_ESPACE;
+    }
+
+  *ringbuffer = larger_buf;
+  *rb_size += 512;
+  *deque_start = larger_buf + consumed;
+  *deque_end = larger_buf + consumed + pending;
+  return REG_OK;
+}
+
 reg_errcode_t
 tre_tnfa_run_approx(const tre_tnfa_t *tnfa, const void *string, ssize_t len,
 		    tre_str_type_t type, int *match_tags,
@@ -486,33 +540,14 @@ tre_tnfa_run_approx(const tre_tnfa_t *tnfa, const void *string, ssize_t len,
 	      continue;
 	    *deque_end = &reach_next[id];
 	    deque_end++;
-	    /* Grow the buffer (moving to the heap) if full. */
-	    if (deque_end >= (ringbuffer + rb_size))
+	    if (tre_deque_reserve(&ringbuffer, static_ringbuffer, &rb_size,
+				  &deque_start, &deque_end) != REG_OK)
 	      {
-		tre_tnfa_approx_reach_t **larger_buf;
-		size_t os = deque_start - ringbuffer;
-		size_t oe = deque_end - ringbuffer;
-		rb_size += 512;
-		if (ringbuffer == static_ringbuffer)
-		  larger_buf = xmalloc(sizeof(*ringbuffer) * rb_size);
-		else
-		  larger_buf = xrealloc(ringbuffer, sizeof(*ringbuffer) * rb_size);
-		if (larger_buf == NULL)
-		  {
-		    if (ringbuffer != static_ringbuffer)
-		      xfree(ringbuffer);
 #ifndef TRE_USE_ALLOCA
-		    if (buf)
-		      xfree(buf);
+		if (buf)
+		  xfree(buf);
 #endif /* !TRE_USE_ALLOCA */
-		    return REG_ESPACE;
-		  }
-		if (ringbuffer == static_ringbuffer)
-		  /* Moving from stack to heap: copy existing contents. */
-		  memcpy(larger_buf, ringbuffer, sizeof(static_ringbuffer));
-		ringbuffer = larger_buf;
-		deque_start = ringbuffer + os;
-		deque_end = ringbuffer + oe;
+		return REG_ESPACE;
 	      }
 	  }
 
@@ -545,8 +580,6 @@ tre_tnfa_run_approx(const tre_tnfa_t *tnfa, const void *string, ssize_t len,
 		/* Too many errors or cost too large. */
 		DPRINT(("  delete: from %03d: cost too large\n", id));
 		deque_start++;
-		if (deque_start >= (ringbuffer + rb_size))
-		  deque_start = ringbuffer;
 		continue;
 	      }
 
@@ -643,13 +676,17 @@ tre_tnfa_run_approx(const tre_tnfa_t *tnfa, const void *string, ssize_t len,
 		/* Add to the end of the deque. */
 		*deque_end = &reach_next[dest_id];
 		deque_end++;
-		if (deque_end >= (ringbuffer + rb_size))
-		  deque_end = ringbuffer;
-		assert(deque_end != deque_start);
+		if (tre_deque_reserve(&ringbuffer, static_ringbuffer, &rb_size,
+				      &deque_start, &deque_end) != REG_OK)
+		  {
+#ifndef TRE_USE_ALLOCA
+		    if (buf)
+		      xfree(buf);
+#endif /* !TRE_USE_ALLOCA */
+		    return REG_ESPACE;
+		  }
 	      }
 	    deque_start++;
-	    if (deque_start >= (ringbuffer + rb_size))
-	      deque_start = ringbuffer;
 	  }
 
 	if (ringbuffer != static_ringbuffer)
