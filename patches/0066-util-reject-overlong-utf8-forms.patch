Reject overlong UTF-8 forms in utf8toucs().

utf8toucs() (src/main/util.c) rejects surrogates (U+D800..U+DFFF) only
in its 3-byte branch, and no branch rejects overlong (non-shortest)
forms, so the same code points get through as 4-, 5- or 6-byte
sequences such as F0 8D BF B0 (U+DFF0).  On Linux, toupper() and
tolower() convert the result back with wcstoutf8(), which warns
"unpaired surrogate Unicode point" for each unpaired surrogate on both
its sizing and its writing pass, and every warning runs R's condition
machinery even with options(warn = -1).  Overlong 2- and 3-byte forms
of NUL decode to a 0 wide character and truncate the string.

Overlong forms are now rejected in every branch, as validUTF8() already
does, and give the usual "invalid input ... in 'utf8towcs'" error.

Found by OSS-Fuzz (libFuzzer_r_character): testcase 6741769633726464,
an unreproducible Timeout in slot 25 (toupper() of UTF-8-marked input).
The 56 KB input holds 5941 overlong surrogates, so toupper() raised
11882 warnings: 2.0 s under ASan on an arm64 workstation, past 25 s on
the bot.  With this patch the input is rejected in 31 ms.

Upstream status: R Bugzilla 19337 (P3) and r-devel/r-svn PR #509, both
filed 2026-11-17.  The upstream PR also adds a regression test to
tests/reg-fuzz.R, left out here so this carry patch does not go stale
with that file.
Delete this patch once the fix lands in R trunk.

diff --git a/src/main/util.c b/src/main/util.c
index 0ead3b3613..a7065d524a 100644
--- a/src/main/util.c
+++ b/src/main/util.c
@@ -1405,6 +1405,7 @@ utf8toucs(wchar_t *wc, const char *s)
 	if(strlen(s) < 2) return (size_t)-2;
 	if ((s[1] & 0xC0) == 0x80) {
 	    *w = (wchar_t) (((byte & 0x1F) << 6) | (s[1] & 0x3F));
+	    if(*w < 0x80) return (size_t)-1; /* overlong */
 	    return 2;
 	} else return (size_t)-1;
     } else if (byte < 0xF0) {
@@ -1414,6 +1415,7 @@ utf8toucs(wchar_t *wc, const char *s)
 			    | (unsigned int) ((s[1] & 0x3F) << 6)
 			    | (s[2] & 0x3F));
 	    byte = (unsigned int) *w;
+	    if(byte < 0x800) return (size_t)-1; /* overlong */
 	    /* Surrogates range */
 	    if(byte >= 0xD800 && byte <= 0xDFFF) return (size_t)-1;
 	    if(byte == 0xFFFE || byte == 0xFFFF) return (size_t)-1;
@@ -1427,6 +1429,10 @@ utf8toucs(wchar_t *wc, const char *s)
 			| (unsigned int) ((s[1] & 0x3F) << 12)
 			| (unsigned int) ((s[2] & 0x3F) << 6)
 			| (s[3] & 0x3F));
+	    /* Overlong (non-shortest) forms are invalid in every branch;
+	       here they could also encode NUL or the surrogates the
+	       3-byte branch rejects. */
+	    if(cvalue < 0x10000) return (size_t)-1;
 	    if(sizeof(wchar_t) < 4) /* Assume UTF-16 and return high surrogate.  Users need to call utf8toutf16low next. */
 		*w = (wchar_t) ((cvalue - 0x10000) >> 10) | 0xD800;
 	    else
@@ -1442,11 +1448,13 @@ utf8toucs(wchar_t *wc, const char *s)
 	if(strlen(s) < 5) return (size_t)-2;
 	if (((s[1] & 0xC0) == 0x80) && ((s[2] & 0xC0) == 0x80)
 	    && ((s[3] & 0xC0) == 0x80) && ((s[4] & 0xC0) == 0x80)) {
-	    *w = (wchar_t) (((byte & 0x03) << 24)
+	    unsigned int cvalue = (((byte & 0x03) << 24)
 			    | (unsigned int) ((s[1] & 0x3F) << 18)
 			    | (unsigned int) ((s[2] & 0x3F) << 12)
 			    | (unsigned int) ((s[3] & 0x3F) << 6)
 			    | (s[4] & 0x3F));
+	    if(cvalue < 0x200000) return (size_t)-1; /* overlong */
+	    *w = (wchar_t) cvalue;
 	    return 5;
 	} else return (size_t)-1;
     } else if (byte < 0xFE) {
@@ -1454,12 +1462,14 @@ utf8toucs(wchar_t *wc, const char *s)
 	if (((s[1] & 0xC0) == 0x80) && ((s[2] & 0xC0) == 0x80)
 	    && ((s[3] & 0xC0) == 0x80) && ((s[4] & 0xC0) == 0x80)
 	    && ((s[5] & 0xC0) == 0x80)) {
-	    *w = (wchar_t) (((byte & 0x01) << 30)
+	    unsigned int cvalue = (((byte & 0x01) << 30)
 			    | (unsigned int) ((s[1] & 0x3F) << 24)
 			    | (unsigned int) ((s[2] & 0x3F) << 18)
 			    | (unsigned int) ((s[3] & 0x3F) << 12)
 			    | (unsigned int) ((s[4] & 0x3F) << 6)
 			    | (s[5] & 0x3F));
+	    if(cvalue < 0x4000000) return (size_t)-1; /* overlong */
+	    *w = (wchar_t) cvalue;
 	    return 6;
 	} else return (size_t)-1;
     } else return (size_t)-1;
