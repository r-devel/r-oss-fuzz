+attribute_hidden Rboolean R_cycle_detected(SEXP s, SEXP child) {
+    switch (TYPEOF(s)) {
+    case NILSXP:
+    case SYMSXP:
+    case ENVSXP:
+    case SPECIALSXP:
+    case BUILTINSXP:
+    case EXTPTRSXP:
+    case BCODESXP:
+    case WEAKREFSXP:
+	/* Cycles through these objects are OK. */
+	return FALSE;
+    }
