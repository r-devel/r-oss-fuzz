 			if(streql(to, "ASCII//TRANSLIT")) {
 			    to = "ASCII";
-			    arg_obj = Riconv_open(to, from);
+			    cd.arg_obj = Riconv_open(to, from);
 			    if(!sub) sub = "?";
 			}
-			if(arg_obj == (iconv_t)(-1))
+			if(cd.arg_obj == (iconv_t)(-1))
