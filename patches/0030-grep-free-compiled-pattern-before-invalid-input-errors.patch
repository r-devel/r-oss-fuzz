Fix a memory leak in gsub() and regexec() when an input string is
invalid in the current encoding.

do_gsub() and do_regexec() (src/main/grep.c) compile the pattern first
and validate each element of 'text' as they go.  An element that is not
valid (an invalid multibyte string in the locale, or invalid UTF-8)
raises "input string N is invalid ..." from inside the loop, and that
error unwinds past the tre_regfree() / pcre2_code_free() at the end of
the function, leaking the compiled pattern (TRE: a few hundred bytes
plus the automaton; PCRE2: the code, match data, match context and
character tables).

    ==1==ERROR: LeakSanitizer: detected memory leaks
    Direct leak of 104 byte(s) in 1 object(s) allocated from:
        #1 tre_compile  src/extra/tre/tre-compile.c:1953
        #2 do_gsub      src/main/grep.c:2230

grep(), grepl(), regexpr(), gregexpr() and strsplit() only warn and
return NA for such an element, so they are not affected.

Reachable from R whenever gsub()/sub() or regexec() meet a string with
invalid bytes, which is common when the text came from a file or a
connection:

    gsub("[\n\r]*", "", "\xff\xfe")
    #> Error in gsub(...) : input string 1 is invalid

Release the compiled pattern before signalling, by moving do_gsub()'s
teardown into a helper it also calls on the error paths, and by calling
tre_regfree() before the two errors in do_regexec().

Found by CIFuzz on r-oss-fuzz PR #37 (libFuzzer_r_load: load()'s R
code gsub()s the file's magic bytes into its deprecation warning, so a
non-UTF-8 magic takes this path).

Upstream status: r-devel/r-svn PR #365; R Bugzilla report drafted (2026-10-08).
Delete this patch once the fix lands in R trunk (ossfuzz.sh will report
it as already-applied in the meantime, which is harmless).

--- a/src/main/grep.c
+++ b/src/main/grep.c
@@ -2091,6 +2091,43 @@
  * either once or globally.
  * The functions are loosely patterned on the "sub" and "gsub" in "nawk". */
 
+/* Release whatever do_gsub() compiled.  Also called before an error is
+   signalled part-way through the text vector, since the unwind would
+   otherwise leak the compiled pattern. */
+static void gsub_free_pattern(bool fixed_opt, bool perl_opt, regex_t *reg,
+			      const unsigned char *tables,
+#ifdef HAVE_PCRE2
+			      pcre2_code *re, pcre2_match_data *mdata,
+			      pcre2_match_context *mcontext)
+#else
+			      pcre *re_pcre, pcre_extra *re_pe)
+#endif
+{
+    if (fixed_opt) ;
+    else if (perl_opt) {
+#ifdef HAVE_PCRE2
+	pcre2_match_data_free(mdata);
+	pcre2_code_free(re);
+	pcre2_match_context_free(mcontext);
+	if (tables)
+	    /* new PCRE2 will have pcre2_maketables_free() */
+	    free((void *)tables);
+#else
+	if (re_pe) pcre_free_study(re_pe);
+	pcre_free(re_pcre);
+	pcre_free((void *)tables);
+#endif
+    } else tre_regfree(reg);
+}
+
+#ifdef HAVE_PCRE2
+# define GSUB_FREE_PATTERN() \
+    gsub_free_pattern(fixed_opt, perl_opt, &reg, tables, re, mdata, mcontext)
+#else
+# define GSUB_FREE_PATTERN() \
+    gsub_free_pattern(fixed_opt, perl_opt, &reg, tables, re_pcre, re_pe)
+#endif
+
 attribute_hidden SEXP do_gsub(SEXP call, SEXP op, SEXP args, SEXP env)
 {
     SEXP pat, rep, text, ans;
@@ -2247,18 +2284,24 @@
 	    s = CHAR(STRING_ELT(text, i));
 	else if (use_WC) {
 	    ws = wtransChar2(STRING_ELT(text, i));
-	    if (!ws)
+	    if (!ws) {
+		GSUB_FREE_PATTERN();
 		error(_("input string %lld is invalid"), (long long)i+1);
+	    }
 	} else if (use_UTF8) {
 	    s = trCharUTF82(STRING_ELT(text, i));
-	    if (!s || !utf8Valid(s))
