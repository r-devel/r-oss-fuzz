+	    }
 	} else {
 	    s = translateCharFP2(STRING_ELT(text, i));
-	    if (!s || (mbcslocale && !mbcsValid(s)))
+	    if (!s || (mbcslocale && !mbcsValid(s))) {
+		GSUB_FREE_PATTERN();
 		error(_("input string %lld is invalid in this locale"),
 		      (long long)i+1);
+	    }
 	}
 
 	if (fixed_opt) {
