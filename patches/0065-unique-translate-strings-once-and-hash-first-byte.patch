+    PROTECT(data.HashTable);					\
     data.useUTF8 = FALSE; data.useCache = TRUE;			\
-    duplicatedInit(x, &data);
+    duplicatedInit(x, &data);					\
+    if (cacheTranslations(x, &data))				\
+	data.utf8 = allocVector(STRSXP, XLENGTH(x));		\
+    PROTECT(data.utf8 ? data.utf8 : R_NilValue);
 
