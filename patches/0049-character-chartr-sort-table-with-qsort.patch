Sort chartr()'s wide-character translation table with qsort() instead
of an insertion sort.

do_chartr() (src/main/character.c) expands every range in 'old' into
one entry of its xtable, then sorts the table with the ISORT macro (an
insertion sort) and drops duplicate characters with COMPRESS (which
shifts the tail on every hit).  Both are quadratic, and insertion sort
hits its worst case on exactly what a spec with two ranges produces:
two sorted runs.  A spec that repeats a range such as "i-\U1F600"
(128408 code points) twice gives a 256816-entry table that takes ~28s
to sort in a release build and more than libFuzzer's 60s limit under
ASAN.  One range sorts instantly, so this only needs two of them, and a
multibyte locale (in the C locale the spec is rejected).

Sort with qsort() instead, with the entry's position in the spec as a
tie-breaker so that the last mapping given for a character still wins
(qsort() is not stable; the old code relied on the insertion sort
being so), and dedup in a single pass.  The ISORT, COMPRESS and SWAP
macros had no other users.

The upstream PR also adds a regression test (tests/reg-tests-1e.R), not
carried here.

Found by OSS-Fuzz (libFuzzer_r_character, testcase 6599770911866880:
Timeout in do_chartr from chartr(old, toupper(old), x) with a spec that
contains "i-\U1F600" twice).  Not a regression: the range just brackets
the harness change that added the chartr slots (PR #35).

Upstream status: r-devel/r-svn PR #390, filed 2026-10-20; no Bugzilla
report yet.
Delete this patch once the fix lands in R trunk (ossfuzz.sh will report
it as already-applied in the meantime, which is harmless).

diff --git a/src/main/character.c b/src/main/character.c
--- a/src/main/character.c
+++ b/src/main/character.c
@@ -1365,11 +1365,16 @@ tr_get_next_char_from_spec(struct tr_spec **p) {
     return(c);
 }
 
-typedef struct { wchar_t c_old, c_new; } xtable_t;
+/* idx is the entry's position in the spec: qsort() is not stable, and
+   when a character is given more than once the last mapping wins. */
+typedef struct { wchar_t c_old, c_new; int idx; } xtable_t;
 
-static R_INLINE int xtable_comp(const void *a, const void *b)
+static int xtable_comp(const void *a, const void *b)
 {
-    return ((xtable_t *)a)->c_old - ((xtable_t *)b)->c_old;
+    const xtable_t *x = a, *y = b;
+    if (x->c_old != y->c_old)
+	return x->c_old < y->c_old ? -1 : 1;
+    return x->idx < y->idx ? -1 : (x->idx > y->idx);
 }
 
 static R_INLINE int xtable_key_comp(const void *a, const void *b)
@@ -1377,39 +1382,6 @@ static R_INLINE int xtable_key_comp(const void *a, const void *b)
     return *((wchar_t *)a) - ((xtable_t *)b)->c_old;
 }
 
-#define SWAP(_a, _b, _TYPE)                                    \
-{                                                              \
-    _TYPE _t;                                                  \
-    _t    = *(_a);                                             \
-    *(_a) = *(_b);                                             \
-    *(_b) = _t;                                                \
-}
-
-#define ISORT(_base,_num,_TYPE,_comp)                          \
-{                                                              \
-/* insert sort */                                              \
-/* require stable data */                                      \
-    int _i, _j ;                                               \
-    for ( _i = 1 ; _i < _num ; _i++ )                          \
-	for ( _j = _i; _j > 0 &&                               \
-		      (*_comp)(_base+_j-1, _base+_j)>0; _j--)  \
-	   SWAP(_base+_j-1, _base+_j, _TYPE);                  \
-}
-
-#define COMPRESS(_base,_num,_TYPE,_comp)                       \
-{                                                              \
-/* suppress even c_old. last use */                             \
-    int _i,_j ;                                                \
-    for ( _i = 0 ; _i < (*(_num)) - 1 ; _i++ ){                \
-	int rc = (*_comp)(_base+_i, _base+_i+1);               \
-	if (rc == 0){                                          \
-	   for ( _j = _i, _i-- ; _j < (*(_num)) - 1; _j++ )     \
-		*((_base)+_j) = *((_base)+_j+1);               \
-	    (*(_num))--;                                       \
-	}                                                      \
-    }                                                          \
-}
-
 #define BSEARCH(_rc,_key,_base,_nmemb,_TYPE,_comp)             \
 {                                                              \
     size_t l, u, idx;                                          \
@@ -1563,11 +1535,18 @@ attribute_hidden SEXP do_chartr(SEXP call, SEXP op, SEXP args, SEXP env)
 	    else {
 		xtable[i].c_old = c_old;
 		xtable[i].c_new = c_new;
+		xtable[i].idx = (int) i;
 	    }
 	}
 
-	ISORT(xtable, xtable_cnt, xtable_t , xtable_comp);
-	COMPRESS(xtable, &xtable_cnt, xtable_t, xtable_comp);
+	/* Sort by c_old, keeping only the last entry for each: the
+	   insertion sort used before was quadratic in the table size,
+	   and a spec with two large ranges took tens of seconds. */
+	qsort(xtable, xtable_cnt, sizeof(xtable_t), xtable_comp);
+	for (j = 0, i = 0; i < xtable_cnt; i++)
+	    if (i + 1 == xtable_cnt || xtable[i].c_old != xtable[i + 1].c_old)
+		xtable[j++] = xtable[i];
+	xtable_cnt = j;
 
 	PROTECT(y = allocVector(STRSXP, n));
 	vmax = vmaxget();
