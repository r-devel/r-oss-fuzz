Fix a memory leak in the parser when an R error unwinds out of
yyparse(), so the parse target stops tripping LeakSanitizer on the
corpus input that grows the bison stack and then errors.

yyparse(), as generated by bison, keeps its stacks in a 200-entry
local array and moves them to malloc()ed memory once an expression
nests deeper than that; the memory is freed only when yyparse()
returns.  Every R error raised inside the parser (raiseParseError(),
raiseLexError(), an allocation failure) long-jumps past that free.
Plain syntax errors are unaffected, since yyerror() returns normally.
The stored corpus holds an input that hits this deterministically:
about 200 nested unary operators after '|>', then "function '+' not
supported in RHS call of a pipe":

    ==59==ERROR: LeakSanitizer: detected memory leaks
    Direct leak of 18078 byte(s) in 1 object(s) allocated from:
        #0 malloc
        #1 Rf_yyparse gram.c (YYSTACK_ALLOC in the stack-growth block)
        #2 R_Parse1 gram.c
        #3 R_Parse gram.c
        #4 R_ParseVector gram.c
    SUMMARY: AddressSanitizer: 18078 byte(s) leaked in 1 allocation(s).

Define YYMALLOC/YYFREE in gram.y as wrappers that record the live stack
in the SrcRefState, and free it from R_FinalizeSrcRefState(), which the
cleanup context set up by R_InitSrcRefState() already runs on the way
out (gram.y, the checked-in gram.c, and the state struct in
src/include/Parse.h).

Found by fuzzing R with libFuzzer + LeakSanitizer (ClusterFuzzLite
parse target, batch runs 34197555026 and 34322723787; the leaking
input lives in the stored corpus, so every run replays it at startup
and stops with exit code 77).

Upstream status: r-devel/r-svn PR #335.
Delete this patch once the fix lands in R trunk (ossfuzz.sh will report
it as already-applied in the meantime, which is harmless).

diff --git a/src/include/Parse.h b/src/include/Parse.h
index 08cf846b51..a458401748 100644
--- a/src/include/Parse.h
+++ b/src/include/Parse.h
@@ -56,6 +56,8 @@ struct SrcRefState {
     int xxbyteno;		/* Byte number on line */
     int xxparseno;              /* Line number ignoring #line directives */
 
+    void *yystack;		/* Grown bison stack to free if an error unwinds */
+
     SrcRefState* prevState;
 };
 
diff --git a/src/main/gram.c b/src/main/gram.c
index 25fb7e7a79..ac65707817 100644
--- a/src/main/gram.c
+++ b/src/main/gram.c
@@ -351,17 +351,38 @@ NORET static void raiseLexError(const char *, int,
 #define RELEASE_SV(x)  R_ReleaseFromMSet((x), PS_SVS)
 #define CLEAR_SVS()    R_ReleaseMSet(PS_SVS, 500)
 
-/* Memory leak
-
-   yyparse(), as generated by bison, allocates extra space for the parser
-   stack using malloc(). Unfortunately this means that there is a memory
-   leak in case of an R error (long-jump). In principle, we could define
-   yyoverflow() to relocate the parser stacks for bison and allocate say on
-   the R heap, but yyoverflow() is undocumented and somewhat complicated
-   (we would have to replicate some macros from the generated parser here).
+/* Parser stack allocation
+
+   yyparse(), as generated by bison, grows its stacks with malloc() once
+   they outgrow the initial YYINITDEPTH entries, and frees them only when
+   it returns. An R error raised from inside the parser (raiseParseError(),
+   raiseLexError(), an allocation failure) long-jumps past that free, so
+   route the allocation through the functions below: they record the live
+   stack in ParseState, and R_FinalizeSrcRefState() -- run by the cleanup
+   context that R_InitSrcRefState() establishes -- releases it on the way
+   out. bison frees an outgrown stack right after copying it into its
+   replacement, so recording only the newest allocation is enough.
    The same problem exists at least in the Rd and LaTeX parsers in tools.
 */
 
+#define YYMALLOC yystack_malloc
+#define YYFREE   yystack_free
+
+static void *yystack_malloc(size_t size)
+{
+    void *p = malloc(size);
+    if (p)
+	ParseState.yystack = p;
+    return p;
+}
+
+static void yystack_free(void *p)
+{
+    if (p == ParseState.yystack)
+	ParseState.yystack = NULL;
+    free(p);
+}
+
 #include <rlocale.h>
 #ifdef HAVE_LANGINFO_CODESET
 # include <langinfo.h>
@@ -3901,6 +3922,7 @@ void R_InitSrcRefState(RCNTXT* cptr)
 	if (prev == NULL)
 	    error(_("allocation of source reference state failed"));
     	PutSrcRefState(prev);
+	ParseState.yystack = NULL;
 	ParseState.prevState = prev;
 	ParseState.sexps = allocVector(VECSXP, 7);
 	ParseState.data = R_NilValue;
@@ -3935,6 +3957,12 @@ void R_FinalizeSrcRefState(void)
     PS_SET_ORIGINAL(R_NilValue);
     CLEAR_SVS();
 
+    /* a stack yyparse() was still using when an error unwound past it */
+    if (ParseState.yystack) {
+	free(ParseState.yystack);
+	ParseState.yystack = NULL;
+    }
+
     /* Free the data, text and ids if we are restoring a previous state,
        or if they have grown too large */
     if (PS_DATA != R_NilValue) {
@@ -3979,6 +4007,7 @@ static void UseSrcRefState(SrcRefState *state)
     ParseState.xxcolno = state->xxcolno;
     ParseState.xxbyteno = state->xxbyteno;
     ParseState.xxparseno = state->xxparseno;
+    ParseState.yystack = state->yystack;
     ParseState.prevState = state->prevState;
     busy = true;
 }
@@ -3994,6 +4023,7 @@ static void PutSrcRefState(SrcRefState *state)
     state->xxcolno = ParseState.xxcolno;
     state->xxbyteno = ParseState.xxbyteno;
     state->xxparseno = ParseState.xxparseno;
+    state->yystack = ParseState.yystack;
     state->prevState = ParseState.prevState;
 }
 
