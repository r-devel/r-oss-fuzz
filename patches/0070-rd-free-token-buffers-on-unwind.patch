Free the parse_Rd() lexer's token buffer when an R error interrupts a
token, so the rd target can keep leak detection on.

The lexer functions in src/library/tools/src/gramRd.y start each token in
a 128-byte stack array; TEXT_PUSH moved it to a malloc()ed buffer once it
outgrew that, and only a normal return freed it.  A macro name over 10000
bytes makes KeywordLookup()'s install() fail after mkMarkup() has grown
the buffer to 16 KB (oss-fuzz testcase 6059426703015936), and allocation
failures under the harness's vector heap cap interrupt the other lexer
functions the same way.  Allocate the grown buffer with R_alloc() inside
a vmaxget()/vmaxset() bracket, so the long jump releases it.

Upstream status: r-devel/r-svn PR #522, R Bugzilla 19360 (both
2026-11-22).
Delete this patch once the fix lands in R trunk (ossfuzz.sh will report
it as already-applied in the meantime, which is harmless).

--- a/src/library/tools/src/gramRd.c
+++ b/src/library/tools/src/gramRd.c
@@ -4083,11 +4083,8 @@ static void yyerror(const char *s)
 	if (nc >= nstext - 1) {             \
 	    char *old = stext;              \
 	    nstext *= 2;		    \
-	    stext = malloc(nstext);         \
-	    if(!stext) error(_("unable to allocate buffer for long string at line %d"), parseState.xxlineno);\
+	    stext = R_alloc(nstext, 1);     \
 	    memmove(stext, old, nc);        \
-	    if(st1) free(st1);		    \
-	    st1 = stext;		    \
 	    bp = stext+nc; }		    \
 	*bp++ = ((char) c);		    \
 } while(0)
@@ -4185,7 +4182,7 @@ static int token(void)
 static int mkText(int c)
 {
     char st0[INITBUFSIZE];
-    char *st1 = NULL;
+    const void *vmax = vmaxget();
     unsigned int nstext = INITBUFSIZE;
     char *stext = st0, *bp = st0, lookahead;
     
@@ -4217,14 +4214,14 @@ static int mkText(int c)
 stop:
     if (c != '\n') xxungetc(c); /* newline causes a break, but we keep it */
     PRESERVE_SV(yylval = mkString2(stext, bp - stext));
-    if(st1) free(st1);
+    vmaxset(vmax);
     return TEXT;
 }
 
 static int mkComment(int c)
 {
     char st0[INITBUFSIZE];
-    char *st1 = NULL;
+    const void *vmax = vmaxget();
     unsigned int nstext = INITBUFSIZE;
     char *stext = st0, *bp = st0;
     
@@ -4234,7 +4231,7 @@ static int mkComment(int c)
     xxungetc(c);
     
     PRESERVE_SV(yylval = mkString2(stext, bp - stext));
-    if(st1) free(st1);
+    vmaxset(vmax);
     return COMMENT;
 }
 
@@ -4266,7 +4263,7 @@ static int closingRawStringDelim(int c)
 static int mkCode(int c)
 {
     char st0[INITBUFSIZE];
-    char *st1 = NULL;
+    const void *vmax = vmaxget();
     unsigned int nstext = INITBUFSIZE;
     char *stext = st0, *bp = st0;
     
@@ -4393,14 +4390,14 @@ static int mkCode(int c)
     }
     if (c != '\n') xxungetc(c);
     PRESERVE_SV(yylval = mkString2(stext, bp - stext));
-    if(st1) free(st1);
+    vmaxset(vmax);
     return RCODE; 
 }
 
 static int mkMarkup(int c)
 {
     char st0[INITBUFSIZE];
-    char *st1 = NULL;
+    const void *vmax = vmaxget();
     unsigned int nstext = INITBUFSIZE;
     char *stext = st0, *bp = st0;
     int retval = 0, attempt = 0;
@@ -4433,7 +4430,7 @@ static int mkMarkup(int c)
         }
     }
     PRESERVE_SV(yylval = mkString2(stext, bp - stext - 1));
-    if(st1) free(st1);
+    vmaxset(vmax);
     xxungetc(c);
     return retval;
 }
@@ -4441,7 +4438,7 @@ static int mkMarkup(int c)
 static int mkIfdef(int c)
 {
     char st0[INITBUFSIZE];
-    char *st1 = NULL;
+    const void *vmax = vmaxget();
     unsigned int nstext = INITBUFSIZE;
     char *stext = st0, *bp = st0;
     int retval;
@@ -4478,14 +4475,14 @@ static int mkIfdef(int c)
 	}
 	break;
     }
-    if(st1) free(st1);
+    vmaxset(vmax);
     return retval;
 }
 
 static int mkVerb(int c)
 {
     char st0[INITBUFSIZE];
-    char *st1 = NULL;
+    const void *vmax = vmaxget();
     unsigned int nstext = INITBUFSIZE;
     char *stext = st0, *bp = st0;
     
@@ -4518,7 +4515,7 @@ static int mkVerb(int c)
     };
     if (c != '\n') xxungetc(c);
     PRESERVE_SV(yylval = mkString2(stext, bp - stext));
-    if(st1) free(st1);
+    vmaxset(vmax);
     return VERB;  
 }
 
