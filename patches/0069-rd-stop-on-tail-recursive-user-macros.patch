Stop parse_Rd() on a user macro whose expansion ends by calling itself,
directly or through another macro (\newcommand{\foo}{\foo}\foo), so the
rd target stops timing out on such input.

xxgetc() in src/library/tools/src/gramRd.y counts nested expansions in
macrolevel and stops past 1000, but the lexer reads past an expansion's
END_MACRO marker while it scans a macro name at the end of that
expansion, so a recursive call there starts only after the previous
expansion has ended and macrolevel never exceeds 1.  Also count
consecutive expansions that consume no input and raise the same error
past the same limit.  gramRd.c is regenerated with bison 3.8.2.

Found by the rd target with patches/0068 applied.

Upstream status: r-devel/r-svn PR #517, R Bugzilla 19348 (both
2026-11-19).
Delete this patch once the fix lands in R trunk (ossfuzz.sh will report
it as already-applied in the meantime, which is harmless).

--- a/src/library/tools/src/gramRd.c
+++ b/src/library/tools/src/gramRd.c
@@ -3457,6 +3457,7 @@ static int pushback[PUSHBACK_BUFSIZE];
 static int *pushbase;
 static unsigned int npush, pushsize;
 static int macrolevel;
+static int macroline, macrobyte, macrorepeats;
 static int prevpos = 0;
 static int prevlines[PUSHBACK_BUFSIZE];
 static int prevcols[PUSHBACK_BUFSIZE];
@@ -3491,6 +3492,13 @@ static int xxgetc(void)
     	    	macrolevel++;
     	    	if (macrolevel > 1000) 
     	    	    error(_("macros nested too deeply: infinite recursion?"));
+    	    	if (parseState.xxlineno != macroline || parseState.xxbyteno != macrobyte) {
+    	    	    macroline = parseState.xxlineno;
+    	    	    macrobyte = parseState.xxbyteno;
+    	    	    macrorepeats = 0;
+    	    	} else if (++macrorepeats > 1000) {
+    	    	    error(_("macros nested too deeply: infinite recursion?"));
+    	    	}
     	    } else if (c == END_MACRO) macrolevel--;
     	} else  c = ptr_getc();
     } while (c == START_MACRO || c == END_MACRO);
@@ -3641,6 +3649,7 @@ static SEXP ParseRd(ParseStatus *status, SEXP srcfile, bool fragment, SEXP macro
     pushbase = pushback;
     pushsize = PUSHBACK_BUFSIZE;
     macrolevel = 0;
+    macroline = macrobyte = macrorepeats = 0;
     
     parseState.xxmode = LATEXLIKE; 
     parseState.xxitemType = UNKNOWN;
--- a/src/library/tools/src/gramRd.y
+++ b/src/library/tools/src/gramRd.y
@@ -922,6 +922,7 @@ static int pushback[PUSHBACK_BUFSIZE];
 static int *pushbase;
 static unsigned int npush, pushsize;
 static int macrolevel;
+static int macroline, macrobyte, macrorepeats;
 static int prevpos = 0;
 static int prevlines[PUSHBACK_BUFSIZE];
 static int prevcols[PUSHBACK_BUFSIZE];
@@ -956,6 +957,13 @@ static int xxgetc(void)
     	    	macrolevel++;
     	    	if (macrolevel > 1000) 
     	    	    error(_("macros nested too deeply: infinite recursion?"));
+    	    	if (parseState.xxlineno != macroline || parseState.xxbyteno != macrobyte) {
+    	    	    macroline = parseState.xxlineno;
+    	    	    macrobyte = parseState.xxbyteno;
+    	    	    macrorepeats = 0;
+    	    	} else if (++macrorepeats > 1000) {
+    	    	    error(_("macros nested too deeply: infinite recursion?"));
+    	    	}
     	    } else if (c == END_MACRO) macrolevel--;
     	} else  c = ptr_getc();
     } while (c == START_MACRO || c == END_MACRO);
@@ -1106,6 +1114,7 @@ static SEXP ParseRd(ParseStatus *status, SEXP srcfile, bool fragment, SEXP macro
     pushbase = pushback;
     pushsize = PUSHBACK_BUFSIZE;
     macrolevel = 0;
+    macroline = macrobyte = macrorepeats = 0;
     
     parseState.xxmode = LATEXLIKE; 
     parseState.xxitemType = UNKNOWN;
