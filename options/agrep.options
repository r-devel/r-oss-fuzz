# agrep uses TRE's approximate matcher, which can leak on error paths like
# grep's. Disable leak detection via ASAN_OPTIONS (the [libfuzzer] flag does
# not stop the exit-time LeakSanitizer check); memory-error detection stays on.
[asan]
detect_leaks = 0

# The harness rejects inputs over 64 KiB (FUZZ_MAX_INPUT in
# harnesses/agrep.c); tell libFuzzer so it does not spend mutations on
# inputs that will be skipped.
[libfuzzer]
max_len = 65536
# Half of the sessions give slow inputs less energy (README.md, "Engine
# options").
entropic_scale_per_exec_time = random(0, 1)
