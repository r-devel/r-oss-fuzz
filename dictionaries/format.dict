# Numbers that stress width and precision computation
zero="0"
neg_zero="-0"
one_half="0.5"
tiny="1e-300"
denorm="4.9e-324"
huge="1e308"
max_double="1.797693e308"
inf="Inf"
neg_inf="-Inf"
nan="NaN"
na="NA"
hex_float="0x1p-1074"
sci="1e+22"
neg_sci="-1.5e-7"
long_frac="0.1234567890123456789"
int_max="2147483647"
rounding="2.5"
nines="9.999999999999999"
# Separators the slots split on
space=" "
comma=","
semicolon=";"
tab="\x09"
nl="\x0a"
# Multibyte text for width computation
utf8_e_acute="\xc3\xa9"
utf8_wide="\xe4\xb8\xad"
