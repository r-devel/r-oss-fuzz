# Regex dictionary for AFL++
# Tokens that help construct valid/interesting regex patterns

# Anchors
"^"
"$"
"\\A"
"\\Z"
"\\z"
"\\b"
"\\B"
"\\G"

# Quantifiers
"*"
"+"
"?"
"*?"
"+?"
"??"
"*+"
"++"
"?+"
"{1}"
"{1,}"
"{1,5}"
"{0,1}"
"{0,}"
"{10}"
"{100}"

# Character classes
"."
"\\d"
"\\D"
"\\w"
"\\W"
"\\s"
"\\S"
"\\h"
"\\H"
"\\v"
"\\V"
"[a-z]"
"[A-Z]"
"[0-9]"
"[^a-z]"
"[[:alpha:]]"
"[[:digit:]]"
"[[:alnum:]]"
"[[:space:]]"
"[[:punct:]]"
"[[:upper:]]"
"[[:lower:]]"
"[[:xdigit:]]"

# Groups
"("
")"
"(?:"
"(?>"
"(?="
"(?!"
"(?<="
"(?<!"
"(?|"
"(?#"
"(?i)"
"(?m)"
"(?s)"
"(?x)"
"(?-i)"
"(?imsx)"

# Named groups
"(?<name>"
"(?P<name>"
"(?'name'"
"\\k<name>"
"\\k'name'"
"(?P=name)"

# Backreferences
"\\1"
"\\2"
"\\3"
"\\g{1}"
"\\g{-1}"

# Alternation
"|"

# Escapes
"\\\\"
"\\."
"\\*"
"\\+"
"\\?"
"\\["
"\\]"
"\\("
"\\)"
"\\{"
"\\}"
"\\^"
"\\$"
"\\|"
"\\t"
"\\n"
"\\r"
"\\f"
"\\a"
"\\e"
"\\x00"
"\\x7f"
"\\xff"
"\\x{1F600}"
"\\N{U+0041}"
"\\cA"
"\\0"
"\\00"
"\\000"

# PCRE verbs
"(*ACCEPT)"
"(*FAIL)"
"(*F)"
"(*MARK:name)"
"(*COMMIT)"
"(*PRUNE)"
"(*SKIP)"
"(*THEN)"
"(*CR)"
"(*LF)"
"(*CRLF)"
"(*ANY)"
"(*BSR_ANYCRLF)"
"(*UTF)"
"(*UCP)"

# Recursion
"(?R)"
"(?0)"
"(?1)"
"(?&name)"
"(?P>name)"

# Conditionals
"(?(1)"
"(?(name)"
"(?(?="
"(?(DEFINE)"

# Unicode properties
"\\p{L}"
"\\p{Lu}"
"\\p{Ll}"
"\\p{N}"
"\\p{P}"
"\\p{S}"
"\\p{Z}"
"\\P{L}"
"\\p{Han}"
"\\p{Greek}"
"\\p{Arabic}"
"\\p{Emoji}"

# Reset
"\\K"

# Atomic/possessive
"(?>"
"++"
"*+"
"?+"

# Comments
"(?#comment)"

# Subroutine definitions
"(?(DEFINE)"

# Special cases
"[]"
"[^]"
"[-]"
"[a-]"
"[-a]"
"[]]"
"[^]]"
