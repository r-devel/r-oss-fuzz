#
# AFL++ dictionary for scan / delimited text fuzzing.
#
# Field separators, quoting characters, escape sequences,
# NA representations, numeric literals, and structural tokens
# that exercise R's scan() text parser.
#

# Field separators
","
"\x09"
"|"
";"
" "

# Quote characters
"\""
"'"

# Line endings
"\x0a"
"\x0d"
"\x0d\x0a"

# Escape sequences
"\\\""
"\\\\"
"\\n"
"\\t"

# NA representations
"NA"
"NaN"
"na"
"N/A"
"null"
"NULL"
"."

# Comment characters
"#"

# Numeric values
"0"
"1"
"-1"
"3.14"
"1e10"
"Inf"
"-Inf"
"0x1f"
"1+2i"

# Logical values
"TRUE"
"FALSE"
"T"
"F"

# Empty / edge cases
",,"
"\x09\x09"
"\"\""
"\"\"\""
",\x0a"
"\x0a,"
"\x0a\x0a"

# Long fields
"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

# Unicode
"\xc3\xa9"
"\xe4\xb8\xad"

# allowEscapes = TRUE sequences
"\\x41"
"\\101"
"\\u00e9"
"\\U0001f600"

# Typed readers: integer / complex / raw / logical
"-1.5e3i"
"0xff"
"ff"
"0a"
"false"
"1e308"
"1,5"

# NA / comment / decimal-mark configurations
"-"
