# Tokens for the character target.  Slots 9 and up take an auxiliary
# string (regex / fixed split, chartr spec, replacement) before the first
# newline, so regex syntax and chartr ranges are useful alongside the
# multibyte sequences the subject string is tested with.
"\x0a"
"[ ,;]+"
"[[:alpha:]]"
"[[:space:]]"
"[^a-z]"
"a-z"
"A-Z"
"0-9"
"\\d"
"\\w"
"\\s"
"\\b"
"\\p{L}"
"(?i)"
"(?<="
"(?="
"(?:"
"(a|b)*"
"{2,3}"
"{0,}"
"\\1"
"\\\\"
"\\."
"\\x"
"\\u"
"^"
"$"
"|"
"*"
"+"
"?"
"."
