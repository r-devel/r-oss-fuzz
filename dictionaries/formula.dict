# Model formula and derivative vocabulary for the formula target.
# Escapes must be \xHH only: libFuzzer rejects \n and drops the file.

# Formula operators
"~"
"+"
"-"
"*"
"/"
":"
"^"
"%in%"
"|"
"&"
"=="
"("
")"
"."
"0"
"1"
"-1"
"+0"
"^2"
"^3"

# The data frame's columns
"y"
"x"
"z"
"w"
"f"
"g"
"o"
"l"
"m"

# Functions model.frame may evaluate, and the terms() specials
"I("
"log("
"exp("
"sqrt("
"abs("
"sin("
"cos("
"offset("
"cbind("
"factor("
"as.numeric("
"interaction("
"s("
"strata("

# Entries of deriv()'s derivatives table
"pnorm("
"dnorm("
"gamma("
"lgamma("
"digamma("
"trigamma("
"psigamma("
"besselJ("
"besselY("
"besselI("
"besselK("
"tan("
"atan("
"sinpi("
"cospi("
"tanpi("
"log1p("
"expm1("
"log2("
"log10("
"sinh("
"cosh("
