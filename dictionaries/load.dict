# load() magic numbers: current, pre-1.4.0, and the numeric-magic era
magic_rda1="RDA1\x0a"
magic_rdb1="RDB1\x0a"
magic_rdx1="RDX1\x0a"
magic_rda2="RDA2\x0a"
magic_rdb2="RDB2\x0a"
magic_rdx2="RDX2\x0a"
magic_rda3="RDA3\x0a"
magic_rdb3="RDB3\x0a"
magic_rdx3="RDX3\x0a"
magic_1971="1971\x0a"
magic_1972="1972\x0a"
magic_1975="1975\x0a"
magic_1976="1976\x0a"
magic_1977="1977\x0a"
magic_too_new="RD"

# ASCII-format tokens (both v1 NewAsciiLoad and v2/v3 ascii streams)
ascii_na="NA"
ascii_inf="Inf"
ascii_ninf="-Inf"
ascii_nan="NaN"
ascii_esc_nl="\\x0a"
ascii_esc_tab="\\x09"
ascii_esc_bs="\\\\"
ascii_esc_quote="\\\""
ascii_esc_oct="\\001"
ascii_zero="0"
ascii_neg1="-1"
ascii_neg2="-2"
ascii_neg3="-3"
ascii_neg4="-4"

# SEXP type codes the item readers switch on
type_sym="1"
type_list="2"
type_clo="3"
type_env="4"
type_prom="5"
type_lang="6"
type_special="7"
type_builtin="8"
type_char="9"
type_lgl="10"
type_int="13"
type_real="14"
type_cplx="15"
type_str="16"
type_dot="17"
type_vec="19"
type_expr="20"
type_bcode="21"
type_extptr="22"
type_weakref="23"
type_raw="24"
type_obj="25"

# internal names for SPECIALSXP/BUILTINSXP lookups
fn_if="if"
fn_c="c"
fn_sum="sum"
