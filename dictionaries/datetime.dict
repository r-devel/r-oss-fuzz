# Date/time dictionary for AFL++.
#
# The harness feeds fuzz input as the *value* string to strptime/
# as.Date/as.POSIXct/as.POSIXlt with preset formats.  Useful tokens
# are therefore date/time fragments (digits, separators, names) that
# R's Rstrptime.h can match against specifiers like %Y, %m, %b, %z.

# --- separators ----------------------------------------------------------
"-"
"/"
":"
"."
" "
"T"
"Z"
"+"
","
";"
"\x09"

# --- digit clusters ------------------------------------------------------
"00"
"01"
"12"
"23"
"24"
"28"
"29"
"30"
"31"
"59"
"60"
"99"
"000"
"123"
"366"

# --- years ---------------------------------------------------------------
"1970"
"1999"
"2000"
"2024"
"2038"
"9999"
"10000"
"-0001"
"0000"

# --- months: numeric -----------------------------------------------------
"01"
"02"
"03"
"04"
"05"
"06"
"07"
"08"
"09"
"10"
"11"
"12"

# --- months: abbreviated (locale C) --------------------------------------
"Jan"
"Feb"
"Mar"
"Apr"
"May"
"Jun"
"Jul"
"Aug"
"Sep"
"Oct"
"Nov"
"Dec"

# --- months: full --------------------------------------------------------
"January"
"February"
"March"
"April"
"June"
"July"
"August"
"September"
"October"
"November"
"December"

# --- weekdays: abbreviated -----------------------------------------------
"Mon"
"Tue"
"Wed"
"Thu"
"Fri"
"Sat"
"Sun"

# --- weekdays: full ------------------------------------------------------
"Monday"
"Tuesday"
"Wednesday"
"Thursday"
"Friday"
"Saturday"
"Sunday"

# --- AM/PM ---------------------------------------------------------------
"AM"
"PM"
"am"
"pm"
"A.M."
"P.M."

# --- timezone offsets ----------------------------------------------------
"+0000"
"-0000"
"+0100"
"-0500"
"+0530"
"-0800"
"+1200"
"-1200"
"+14:00"
"+05:30"
"-05:00"
"Z"

# --- timezone abbreviations ----------------------------------------------
"UTC"
"GMT"
"EST"
"EDT"
"CST"
"CDT"
"MST"
"MDT"
"PST"
"PDT"
"BST"
"JST"
"IST"
"CET"
"CEST"

# --- tz database names ---------------------------------------------------
"America/New_York"
"America/Los_Angeles"
"America/Chicago"
"Europe/London"
"Europe/Paris"
"Europe/Berlin"
"Asia/Tokyo"
"Asia/Shanghai"
"Asia/Kolkata"
"Australia/Sydney"
"Pacific/Auckland"
"Etc/GMT"
"Etc/UTC"
"Etc/GMT+12"

# --- whole ISO-8601 dates/times ------------------------------------------
"1970-01-01"
"1970-01-01 00:00:00"
"1970-01-01T00:00:00Z"
"2000-01-01"
"2024-01-15"
"2024-02-29"
"2023-02-29"
"2024-12-31 23:59:59"
"9999-12-31"
"2038-01-19 03:14:07"
"2024-06-15T12:34:56+05:30"
"2024-01-15T12:00:00.000Z"
"2024-01-15T12:00:00.123456789"

# --- common US-style dates -----------------------------------------------
"01/15/2024"
"15/01/2024"
"1/1/70"
"12/31/99"

# --- alt formats ---------------------------------------------------------
"15 Jan 2024"
"Jan 15, 2024"
"15-Jan-2024"
"2024.01.15"
"20240115"
"20240115T123456Z"

# --- time-only -----------------------------------------------------------
"12:30:00"
"23:59:60"
"24:00:00"
"00:00:00.000"
"3:04 PM"
"15:04:05"

# --- special / edge ------------------------------------------------------
"NA"
" "
"0"
"now"

# --- day-of-year / week --------------------------------------------------
"001"
"060"
"366"
"W01"
"W52"
"W53"
