# Interesting doubles for the nmath target, as the little-endian bytes
# the harness reads.  Escapes must be \xHH only: libFuzzer rejects \n
# and drops the file.
# zero
"\x00\x00\x00\x00\x00\x00\x00\x00"
# negative zero
"\x00\x00\x00\x00\x00\x00\x00\x80"
# one
"\x00\x00\x00\x00\x00\x00\xF0\x3F"
# minus one
"\x00\x00\x00\x00\x00\x00\xF0\xBF"
# half
"\x00\x00\x00\x00\x00\x00\xE0\x3F"
# two
"\x00\x00\x00\x00\x00\x00\x00\x40"
# ten
"\x00\x00\x00\x00\x00\x00\x24\x40"
# 1e-10
"\xBB\xBD\xD7\xD9\xDF\x7C\xDB\x3D"
# 1e10
"\x00\x00\x00\x20\x5F\xA0\x02\x42"
# 1e100
"\x7D\xC3\x94\x25\xAD\x49\xB2\x54"
# 1e300
"\x9C\x75\x00\x88\x3C\xE4\x37\x7E"
# 1e-300
"\x59\xF3\xF8\xC2\x1F\x6E\xA5\x01"
# 2^31
"\x00\x00\x00\x00\x00\x00\xE0\x41"
# 2^53
"\x00\x00\x00\x00\x00\x00\x40\x43"
# 2^53 + 2
"\x01\x00\x00\x00\x00\x00\x40\x43"
# DBL_MAX
"\xFF\xFF\xFF\xFF\xFF\xFF\xEF\x7F"
# DBL_MIN
"\x00\x00\x00\x00\x00\x00\x10\x00"
# smallest subnormal
"\x01\x00\x00\x00\x00\x00\x00\x00"
# DBL_EPSILON
"\x00\x00\x00\x00\x00\x00\xB0\x3C"
# 1 - DBL_EPSILON/2
"\xFF\xFF\xFF\xFF\xFF\xFF\xEF\x3F"
# Inf
"\x00\x00\x00\x00\x00\x00\xF0\x7F"
# -Inf
"\x00\x00\x00\x00\x00\x00\xF0\xFF"
# NaN
"\x00\x00\x00\x00\x00\x00\xF8\x7F"
# R's NA_real_
"\xA2\x07\x00\x00\x00\x00\xF0\x7F"
